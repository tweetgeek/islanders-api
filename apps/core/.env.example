# Port HTTP aplikacji
PORT=3100
# development | test | production
NODE_ENV=development
# Postgres z docker-compose.yml
DATABASE_URL=postgres://islanders:islanders@localhost:5432/islanders_world_1
# Redis z docker-compose.yml — magazyn limitera zapytań (rate limit)
REDIS_URL=redis://localhost:6379
# Min. 32 znaki. Wygeneruj: openssl rand -base64 48
JWT_SECRET=zmien-mnie-na-losowy-sekret-o-dlugosci-co-najmniej-32-znakow
# Czas życia tokenów: liczba + s|m|h|d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Repozytorium klienta Godot; test parity czyta stamtąd contract/world-parity.json
ISLANDERS_CLIENT_DIR=../../../islanders
# Dokumentacja pod /api/docs. Domyślnie true poza production.
SWAGGER_ENABLED=true
# Limity zapytań na minutę: auth (register/login/refresh) na adres IP, reszta na podmiot
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SUBJECT_PER_MINUTE=120
# Sufit żądań na minutę z jednego adresu, liczony przed uwierzytelnieniem
RATE_LIMIT_IP_PER_MINUTE=600
# Prefiks kluczy limitera w Redisie
RATE_LIMIT_PREFIX=rl-world-1
# Co ile milisekund przemiatać zaległe zlecenia (obok przemiatania przy starcie)
SWEEP_INTERVAL_MS=60000
# Czy ten proces ma uruchamiać workera kolejki zleceń
WORKER_ENABLED=true
# false | true | liczba przeskoków | lista podsieci po przecinku
TRUST_PROXY=false
