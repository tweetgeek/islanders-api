# Port HTTP publiczny (klienci światów)
PORT=3000
# Port HTTP wewnętrzny (operatorzy, tooling, serwis-do-serwisu)
ADMIN_PORT=3001
# development | test | production
NODE_ENV=development
# Postgres z docker-compose.yml, osobna baza dla auth
DATABASE_URL=postgres://islanders:islanders@localhost:5432/islanders_auth
# Redis z docker-compose.yml
REDIS_URL=redis://localhost:6379
# Issuer w wydawanych tokenach (iss)
AUTH_ISSUER=https://users.islanders.online
# Klucze podpisujące JWT (EdDSA/Ed25519) jako tablica JSON; wygeneruj: npm run keys:generate
JWT_SIGNING_KEYS=[]
# Czas życia tokenów: liczba + s|m|h|d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Klienci serwisowi (światy) uprawnieni do tokenów serwisowych, jako tablica JSON
SERVICE_CLIENTS=[]
# Co ile sondować dostępność światów
WORLD_PROBE_INTERVAL=30s
# Dokumentacja pod /docs. Domyślnie true poza production.
SWAGGER_ENABLED=true
# Limity zapytań na minutę: auth (register/login/refresh) na adres IP, reszta na podmiot
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SUBJECT_PER_MINUTE=120
# Sufit żądań na minutę z jednego adresu, liczony przed uwierzytelnieniem
RATE_LIMIT_IP_PER_MINUTE=600
# Prefiks kluczy limitera w Redisie
RATE_LIMIT_PREFIX=rl
# false | true | liczba przeskoków | lista podsieci po przecinku
TRUST_PROXY=false
